# Telegram Bot Configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=123456789
SUPPORT=@your_support

# Mandatory Channel Membership (set REQUIRED_CHANNEL_ID=0 to disable)
REQUIRED_CHANNEL_ID=0
REQUIRED_CHANNEL_INVITE=

# 3X-UI Panel (API Token Authentication Only)
PANEL_URL=https://panel.example.com:2053
PANEL_PATH=/panel_secret_path
PANEL_API_TOKEN=your_3xui_bearer_api_token
INBOUND_ID=1
INBOUNDS=1:Germany-Reality:xtls-rprx-vision
SUB_BASE_URL=https://sub.example.com:2096/sub

# Optional Local SOCKS5 Proxy (useful for Iran servers)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Payment Cards (format: CARD_NUMBER:HOLDER_NAME,CARD_NUMBER:HOLDER_NAME)
CARDS=6037-9911-0000-0000:نام صاحب کارت

# Log Channel (set 0 to disable)
LOG_CHANNEL_ID=0

# Expiry & Low-Traffic Reminder System
REMINDER_ENABLED=y
REMINDER_GB_THRESHOLD=3
REMINDER_DAYS_THRESHOLD=3

# Built-in Web Panel
WEB_PANEL_ENABLED=y
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=8080
WEB_PANEL_PASS=admin1234

# SQLite Database Path
DB_PATH=vpn_bot.db
